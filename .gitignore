<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>AI Nexus Pro v5</title>
    <meta name="theme-color" content="#7c3aed">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🧠</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <!-- Marked.js for Markdown rendering -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.6/marked.min.js"></script>
    
    <style>
        :root {
            --bg: #080b14;
            --bg2: #0d1117;
            --bg3: #161b27;
            --bg4: #1e2535;
            --text: #e2e8f7;
            --text2: #7f8caa;
            --text3: #4a5568;
            --accent: #7c3aed;
            --accent2: #6d28d9;
            --accent3: #a855f7;
            --cyan: #06b6d4;
            --pink: #ec4899;
            --green: #10b981;
            --orange: #f59e0b;
            --red: #ef4444;
            --gold: #fbbf24;
            --border: #1e2535;
            --border2: #2d3748;
            --glow: rgba(124,58,237,0.25);
            --glass: rgba(13,17,23,0.7);
        }
        .light-mode {
            --bg: #f1f5f9;
            --bg2: #ffffff;
            --bg3: #f8fafc;
            --bg4: #e2e8f0;
            --text: #0f172a;
            --text2: #475569;
            --text3: #94a3b8;
            --border: #e2e8f0;
            --border2: #cbd5e1;
            --glow: rgba(124,58,237,0.15);
            --glass: rgba(255,255,255,0.8);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'DM Mono', 'Segoe UI', monospace;
            background: var(--bg);
            color: var(--text);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transition: background 0.3s, color 0.3s;
        }
        /* Animated background */
        body::before {
            content: '';
            position: fixed;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at 20% 50%, rgba(124,58,237,0.06) 0%, transparent 50%),
                        radial-gradient(ellipse at 80% 20%, rgba(6,182,212,0.04) 0%, transparent 50%),
                        radial-gradient(ellipse at 60% 80%, rgba(236,72,153,0.04) 0%, transparent 50%);
            pointer-events: none;
            z-index: 0;
        }
        /* Navbar */
        .navbar {
            background: var(--glass);
            backdrop-filter: blur(20px);
            padding: 0 16px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border);
            z-index: 100;
            position: relative;
        }
        .logo {
            font-family: 'Syne', sans-serif;
            font-size: 1.05em;
            font-weight: 800;
            background: linear-gradient(135deg, #7c3aed, #06b6d4, #a855f7);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            display: flex;
            align-items: center;
            gap: 7px;
            letter-spacing: -0.02em;
        }
        .logo-badge {
            background: linear-gradient(135deg, var(--accent), var(--cyan));
            -webkit-text-fill-color: white;
            font-size: 0.55em;
            padding: 2px 7px;
            border-radius: 20px;
            font-family: 'DM Mono', monospace;
            font-weight: 500;
            letter-spacing: 0;
        }
        .nav-actions { display: flex; gap: 5px; align-items: center; }
        .icon-btn {
            background: var(--bg3);
            border: 1px solid var(--border);
            color: var(--text);
            width: 34px;
            height: 34px;
            border-radius: 9px;
            cursor: pointer;
            font-size: 0.95em;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        .icon-btn:hover { background: var(--accent); border-color: var(--accent); transform: translateY(-1px); box-shadow: 0 4px 12px var(--glow); }
        .icon-btn.recording { background: var(--red); border-color: var(--red); animation: pulse-red 1.5s infinite; }
        @keyframes pulse-red {
            0%,100% { box-shadow: 0 0 0 0 rgba(239,68,68,0.4); }
            50% { box-shadow: 0 0 0 8px rgba(239,68,68,0); }
        }
        .badge {
            position: absolute;
            top: -3px; right: -3px;
            background: var(--red);
            color: white;
            border-radius: 50%;
            width: 15px; height: 15px;
            font-size: 0.58em;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Syne', sans-serif;
            font-weight: 700;
        }
        /* Tabs */
        .tabs {
            display: flex;
            background: var(--bg2);
            border-bottom: 1px solid var(--border);
            overflow-x: auto;
            scrollbar-width: none;
            position: relative;
            z-index: 50;
        }
        .tabs::-webkit-scrollbar { display: none; }
        .tab {
            padding: 11px 16px;
            background: none;
            border: none;
            color: var(--text2);
            cursor: pointer;
            font-size: 0.8em;
            font-family: 'Syne', sans-serif;
            font-weight: 600;
            white-space: nowrap;
            border-bottom: 2px solid transparent;
            transition: all 0.25s;
            letter-spacing: 0.02em;
        }
        .tab.active { color: var(--accent3); border-bottom-color: var(--accent3); }
        .tab:hover:not(.active) { color: var(--text); }
        /* Panels */
        .panels { flex: 1; overflow: hidden; position: relative; z-index: 1; }
        .panel { display: none; height: 100%; overflow-y: auto; padding: 16px; }
        .panel.active { display: flex; flex-direction: column; }
        /* Chat */
        .chat-container { display: flex; flex-direction: column; height: 100%; }
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            scrollbar-width: thin;
            scrollbar-color: var(--border2) transparent;
        }
        .chat-messages::-webkit-scrollbar { width: 4px; }
        .chat-messages::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 2px; }
        .message {
            padding: 12px 16px;
            border-radius: 14px;
            max-width: 88%;
            word-wrap: break-word;
            animation: msgIn 0.28s cubic-bezier(0.34,1.56,0.64,1);
            font-size: 0.875em;
            line-height: 1.65;
            position: relative;
        }
        @keyframes msgIn {
            from { opacity: 0; transform: translateY(12px) scale(0.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .user-message {
            background: linear-gradient(135deg, var(--accent), #5b21b6);
            color: white;
            align-self: flex-end;
            border-bottom-right-radius: 4px;
            box-shadow: 0 4px 16px rgba(124,58,237,0.3);
        }
        .ai-message {
            background: var(--bg3);
            color: var(--text);
            align-self: flex-start;
            border-bottom-left-radius: 4px;
            border-left: 2px solid var(--accent3);
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }
        .ai-message .msg-header {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 6px;
            font-family: 'Syne', sans-serif;
            font-size: 0.78em;
            font-weight: 700;
            color: var(--accent3);
            opacity: 0.8;
        }
        .system-message {
            background: rgba(6,182,212,0.07);
            border: 1px solid rgba(6,182,212,0.2);
            align-self: center;
            font-size: 0.8em;
            text-align: center;
            max-width: 92%;
            color: var(--cyan);
            border-radius: 10px;
        }
        /* Markdown styles in messages */
        .ai-message p { margin-bottom: 8px; }
        .ai-message p:last-child { margin-bottom: 0; }
        .ai-message code {
            background: var(--bg4);
            border: 1px solid var(--border2);
            padding: 2px 6px;
            border-radius: 5px;
            font-family: 'DM Mono', monospace;
            font-size: 0.9em;
            color: var(--cyan);
        }
        .ai-message pre {
            background: var(--bg4);
            border: 1px solid var(--border2);
            border-radius: 9px;
            padding: 12px 14px;
            overflow-x: auto;
            margin: 8px 0;
            position: relative;
        }
        .ai-message pre code {
            background: none;
            border: none;
            padding: 0;
            color: var(--text);
            font-size: 0.87em;
        }
        .ai-message ul, .ai-message ol { padding-left: 18px; margin: 6px 0; }
        .ai-message li { margin: 3px 0; }
        .ai-message h1,.ai-message h2,.ai-message h3 {
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            margin: 10px 0 5px;
            color: var(--accent3);
        }
        .ai-message h1 { font-size: 1.1em; }
        .ai-message h2 { font-size: 1.0em; }
        .ai-message h3 { font-size: 0.95em; }
        .ai-message strong { color: var(--gold); font-weight: 600; }
        .ai-message em { color: var(--cyan); }
        .ai-message blockquote {
            border-left: 3px solid var(--accent3);
            padding-left: 10px;
            margin: 6px 0;
            color: var(--text2);
            font-style: italic;
        }
        .ai-message table { width: 100%; border-collapse: collapse; margin: 8px 0; font-size: 0.9em; }
        .ai-message th { background: var(--bg4); padding: 6px 10px; border: 1px solid var(--border2); text-align: left; }
        .ai-message td { padding: 5px 10px; border: 1px solid var(--border2); }
        .ai-message a { color: var(--cyan); text-decoration: none; }
        .ai-message a:hover { text-decoration: underline; }
        /* Message actions */
        .msg-actions {
            display: flex;
            gap: 5px;
            margin-top: 8px;
            opacity: 0;
            transition: opacity 0.2s;
        }
        .message:hover .msg-actions { opacity: 1; }
        .msg-action-btn {
            background: var(--bg4);
            border: 1px solid var(--border2);
            color: var(--text2);
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 0.72em;
            cursor: pointer;
            transition: all 0.15s;
            font-family: 'DM Mono', monospace;
        }
        .msg-action-btn:hover { background: var(--accent); color: white; border-color: var(--accent); }
        /* Typing indicator */
        .typing-indicator {
            display: none;
            align-items: center;
            gap: 5px;
            padding: 10px 16px;
            background: var(--bg3);
            border-radius: 14px;
            border-bottom-left-radius: 4px;
            border-left: 2px solid var(--accent3);
            align-self: flex-start;
            max-width: 100px;
        }
        .typing-indicator.show { display: flex; animation: msgIn 0.28s; }
        .dot {
            width: 7px; height: 7px;
            background: var(--accent3);
            border-radius: 50%;
            animation: bounce 1.4s infinite;
        }
        .dot:nth-child(2) { animation-delay: 0.2s; }
        .dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes bounce {
            0%,80%,100% { transform: translateY(0); opacity: 0.4; }
            40% { transform: translateY(-5px); opacity: 1; }
        }
        /* File message */
        .file-message {
            background: var(--bg3);
            border: 1px dashed var(--accent);
            border-radius: 12px;
            padding: 10px 14px;
            align-self: flex-start;
            cursor: pointer;
        }
        .file-message img, .file-message video { max-width: 200px; max-height: 150px; border-radius: 8px; display: block; margin-top: 6px; }
        .file-message audio { width: 200px; margin-top: 6px; }
        /* Quick actions */
        .quick-actions {
            display: flex;
            gap: 6px;
            padding: 8px 16px;
            overflow-x: auto;
            background: var(--bg2);
            border-top: 1px solid var(--border);
            scrollbar-width: none;
        }
        .quick-actions::-webkit-scrollbar { display: none; }
        .quick-action {
            padding: 5px 11px;
            background: var(--bg3);
            border: 1px solid var(--border2);
            border-radius: 20px;
            color: var(--text2);
            font-size: 0.75em;
            font-family: 'DM Mono', monospace;
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.2s;
        }
        .quick-action:hover { background: var(--accent); color: white; border-color: var(--accent); transform: translateY(-1px); }
        /* Input area */
        .input-area {
            padding: 10px 14px;
            background: var(--bg2);
            display: flex;
            gap: 7px;
            align-items: center;
            border-top: 1px solid var(--border);
        }
        .input-tools { display: flex; gap: 4px; }
        #messageInput {
            flex: 1;
            padding: 10px 16px;
            border: 1.5px solid var(--border2);
            border-radius: 22px;
            background: var(--bg3);
            color: var(--text);
            font-size: 0.875em;
            font-family: 'DM Mono', monospace;
            outline: none;
            transition: all 0.25s;
        }
        #messageInput:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--glow); }
        #messageInput::placeholder { color: var(--text3); }
        /* Voice indicator */
        .voice-indicator {
            display: none;
            padding: 7px 14px;
            background: rgba(239,68,68,0.12);
            border: 1px solid rgba(239,68,68,0.3);
            border-radius: 20px;
            color: var(--red);
            font-size: 0.8em;
            font-family: 'DM Mono', monospace;
            text-align: center;
            animation: pulse-red 1.5s infinite;
        }
        .voice-indicator.active { display: block; }
        /* Send button */
        .send-btn {
            width: 38px; height: 38px;
            border-radius: 12px;
            border: none;
            cursor: pointer;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: white;
            font-size: 1em;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 3px 10px var(--glow);
            flex-shrink: 0;
        }
        .send-btn:hover { transform: translateY(-1px) scale(1.05); box-shadow: 0 5px 16px var(--glow); }
        .send-btn:active { transform: scale(0.95); }
        .send-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
        /* Buttons */
        .btn {
            padding: 9px 18px;
            border-radius: 9px;
            border: none;
            cursor: pointer;
            font-size: 0.85em;
            font-family: 'Syne', sans-serif;
            font-weight: 600;
            transition: all 0.2s;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: white;
            white-space: nowrap;
        }
        .btn:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 4px 12px var(--glow); }
        .btn:active { transform: scale(0.97); }
        .btn-sm { padding: 5px 11px; font-size: 0.77em; border-radius: 7px; }
        .btn-outline { background: transparent; border: 1.5px solid var(--accent); color: var(--accent); box-shadow: none; }
        .btn-outline:hover { background: var(--accent); color: white; }
        .btn-success { background: linear-gradient(135deg, var(--green), #059669); box-shadow: 0 3px 10px rgba(16,185,129,0.3); }
        .btn-danger { background: linear-gradient(135deg, var(--red), #dc2626); box-shadow: 0 3px 10px rgba(239,68,68,0.3); }
        .btn-warning { background: linear-gradient(135deg, var(--orange), #d97706); color: #fff; }
        .btn-cyan { background: linear-gradient(135deg, var(--cyan), #0891b2); }
        /* Section headers */
        .section-title {
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            font-size: 1.15em;
            letter-spacing: -0.02em;
            margin-bottom: 4px;
        }
        .section-sub {
            font-size: 0.8em;
            color: var(--text2);
            margin-bottom: 16px;
        }
        /* Services */
        .service-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 14px;
            margin-top: 14px;
        }
        .service-card {
            background: var(--bg3);
            border: 1.5px solid var(--border);
            border-radius: 14px;
            padding: 18px;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }
        .service-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 2px;
            background: linear-gradient(90deg, var(--accent), var(--cyan));
            opacity: 0;
            transition: opacity 0.3s;
        }
        .service-card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.3); }
        .service-card:hover::before { opacity: 1; }
        .service-card.configured { border-color: rgba(16,185,129,0.4); }
        .service-card.configured::before { opacity: 1; background: linear-gradient(90deg, var(--green), var(--cyan)); }
        .service-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
        .service-name { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.95em; }
        .service-status {
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.7em;
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            letter-spacing: 0.05em;
        }
        .status-ok { background: rgba(16,185,129,0.15); color: var(--green); border: 1px solid rgba(16,185,129,0.3); }
        .status-no { background: rgba(239,68,68,0.1); color: var(--red); border: 1px solid rgba(239,68,68,0.2); }
        .service-desc { font-size: 0.8em; color: var(--text2); margin-bottom: 8px; }
        .service-models { display: flex; flex-wrap: wrap; gap: 4px; margin: 8px 0; }
        .model-tag {
            padding: 4px 9px;
            background: var(--bg4);
            border: 1px solid var(--border2);
            border-radius: 20px;
            font-size: 0.73em;
            font-family: 'DM Mono', monospace;
            cursor: pointer;
            transition: all 0.2s;
            color: var(--text2);
        }
        .model-tag:hover { background: var(--accent); color: white; border-color: var(--accent); }
        .model-tag.active { background: var(--accent); color: white; border-color: var(--accent); font-weight: 500; }
        /* Agents */
        .agent-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 14px;
            margin-top: 14px;
        }
        .agent-card {
            background: var(--bg3);
            border: 1.5px solid var(--border);
            border-radius: 14px;
            padding: 16px;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }
        .agent-card:hover { border-color: var(--accent3); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.25); }
        .agent-card h3 { font-family: 'Syne', sans-serif; font-weight: 700; margin-bottom: 4px; font-size: 0.95em; }
        .agent-role { color: var(--text2); font-size: 0.79em; margin-bottom: 8px; }
        .agent-tags { display: flex; flex-wrap: wrap; gap: 4px; margin: 8px 0; }
        .agent-tag {
            padding: 3px 8px;
            background: rgba(124,58,237,0.15);
            border: 1px solid rgba(124,58,237,0.3);
            border-radius: 20px;
            font-size: 0.7em;
            color: var(--accent3);
        }
        .agent-stats { font-size: 0.77em; color: var(--text2); margin: 6px 0; }
        .agent-actions { display: flex; gap: 6px; margin-top: 10px; }
        /* Store */
        .store-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 14px;
            margin-top: 14px;
        }
        .store-card {
            background: var(--bg3);
            border: 1.5px solid var(--border);
            border-radius: 14px;
            padding: 16px;
            transition: all 0.3s;
            position: relative;
        }
        .store-card:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.3); }
        .store-card.featured { border-color: rgba(251,191,36,0.4); }
        .store-icon {
            width: 46px; height: 46px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--accent), var(--cyan));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5em;
            margin-bottom: 10px;
        }
        .store-card h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.93em; margin-bottom: 3px; }
        .store-author { color: var(--text2); font-size: 0.76em; margin-bottom: 6px; }
        .store-desc { font-size: 0.81em; margin-bottom: 8px; line-height: 1.45; color: var(--text2); }
        .store-tags { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 8px; }
        .store-tag { padding: 3px 7px; background: rgba(6,182,212,0.1); border: 1px solid rgba(6,182,212,0.2); border-radius: 20px; font-size: 0.69em; color: var(--cyan); }
        .store-stats { display: flex; justify-content: space-between; font-size: 0.77em; color: var(--text2); margin-bottom: 10px; }
        .rating { color: var(--gold); }
        .install-btn {
            width: 100%;
            padding: 9px;
            border-radius: 9px;
            border: none;
            cursor: pointer;
            font-size: 0.83em;
            font-family: 'Syne', sans-serif;
            font-weight: 600;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            color: white;
            transition: all 0.2s;
        }
        .install-btn.installed { background: linear-gradient(135deg, var(--green), #059669); }
        .install-btn:hover { opacity: 0.9; transform: translateY(-1px); }
        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            z-index: 2000;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(8px);
        }
        .modal.active { display: flex; }
        .modal-content {
            background: var(--bg2);
            border: 1px solid var(--border2);
            border-radius: 18px;
            padding: 24px;
            width: 92%;
            max-width: 540px;
            max-height: 88vh;
            overflow-y: auto;
            animation: modalIn 0.3s cubic-bezier(0.34,1.56,0.64,1);
            scrollbar-width: thin;
            scrollbar-color: var(--border2) transparent;
        }
        @keyframes modalIn {
            from { opacity: 0; transform: translateY(20px) scale(0.96); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--border);
        }
        .modal-header h2 { font-family: 'Syne', sans-serif; font-weight: 800; font-size: 1.05em; }
        .close-btn {
            background: var(--bg4);
            border: 1px solid var(--border2);
            color: var(--text2);
            width: 30px; height: 30px;
            border-radius: 8px;
            font-size: 1.1em;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }
        .close-btn:hover { background: var(--red); color: white; border-color: var(--red); }
        .form-group { margin-bottom: 13px; }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-size: 0.8em;
            font-family: 'Syne', sans-serif;
            font-weight: 600;
            color: var(--text2);
            letter-spacing: 0.03em;
        }
        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 9px 12px;
            border: 1.5px solid var(--border2);
            border-radius: 9px;
            background: var(--bg3);
            color: var(--text);
            font-size: 0.875em;
            font-family: 'DM Mono', monospace;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: var(--accent);
            outline: none;
            box-shadow: 0 0 0 3px var(--glow);
        }
        .form-group small a { color: var(--cyan); text-decoration: none; font-size: 0.85em; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .settings-section {
            background: var(--bg3);
            padding: 16px;
            border-radius: 12px;
            margin-bottom: 12px;
            border: 1px solid var(--border);
        }
        .settings-section h3 {
            font-family: 'Syne', sans-serif;
            font-weight: 700;
            font-size: 0.9em;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        /* Toast */
        .toast {
            position: fixed;
            bottom: 22px;
            right: 22px;
            background: var(--bg3);
            border: 1px solid var(--border2);
            color: var(--text);
            padding: 12px 18px;
            border-radius: 12px;
            z-index: 3000;
            animation: toastIn 0.3s cubic-bezier(0.34,1.56,0.64,1);
            font-weight: 500;
            font-size: 0.85em;
            font-family: 'DM Mono', monospace;
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
            max-width: 300px;
            border-left: 3px solid var(--green);
        }
        @keyframes toastIn {
            from { transform: translateX(100%) scale(0.9); opacity: 0; }
            to { transform: translateX(0) scale(1); opacity: 1; }
        }
        .toast.warning { border-left-color: var(--orange); }
        .toast.error { border-left-color: var(--red); }
        /* Empty state */
        .empty-state {
            text-align: center;
            padding: 50px 20px;
            color: var(--text2);
            font-size: 0.9em;
        }
        .empty-state .empty-icon { font-size: 2.5em; margin-bottom: 12px; opacity: 0.5; }
        /* Backup */
        .backup-actions { display: flex; flex-direction: column; gap: 8px; margin-top: 14px; }
        .info-card {
            background: var(--bg3);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 18px;
            margin-top: 14px;
        }
        .info-card h3 { font-family: 'Syne', sans-serif; font-weight: 700; font-size: 0.9em; margin-bottom: 12px; }
        .storage-bar-wrap {
            height: 7px;
            background: var(--border);
            border-radius: 4px;
            overflow: hidden;
            margin: 10px 0;
        }
        #storageBar {
            height: 100%;
            background: linear-gradient(90deg, var(--accent), var(--cyan));
            width: 0%;
            transition: width 0.5s;
            border-radius: 4px;
        }
        /* Conversation history panel sub-list */
        .conv-list { margin-top: 10px; display: flex; flex-direction: column; gap: 6px; }
        .conv-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 12px;
            background: var(--bg4);
            border-radius: 8px;
            font-size: 0.8em;
            border: 1px solid var(--border);
        }
        .conv-item-info { color: var(--text2); }
        .conv-item-time { font-size: 0.85em; color: var(--text3); }
        /* Scrollbar global */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 3px; }
        /* Responsive */
        @media (max-width: 600px) {
            .form-row { grid-template-columns: 1fr; }
            .service-grid, .agent-grid, .store-grid { grid-template-columns: 1fr; }
        }
        /* Anthropic special badge in services */
        .service-card.anthropic-card { border-color: rgba(168,85,247,0.3); }
        .service-card.anthropic-card::before { opacity: 1; background: linear-gradient(90deg, #7c3aed, #a855f7, #ec4899); }
    </style>
</head>
<body>
    <!-- Navbar -->
    <div class="navbar">
        <div class="logo">
            <span>🧠</span> AI Nexus Pro
            <span class="logo-badge">v5.0</span>
        </div>
        <div class="nav-actions">
            <button class="icon-btn" onclick="toggleTheme()" title="Thème">🌓</button>
            <button class="icon-btn" onclick="exportChat()" title="Exporter chat">📤</button>
            <button class="icon-btn" onclick="openSettings()" title="Paramètres">⚙️</button>
            <button class="icon-btn" onclick="openBackupModal()" title="Sauvegarde">💾</button>
            <button class="icon-btn" onclick="showNotifications()" title="Notifications">
                🔔<span class="badge" id="notifBadge" style="display:none">0</span>
            </button>
        </div>
    </div>
    <!-- Tabs -->
    <div class="tabs">
        <button class="tab active" onclick="switchTab('chat')">💬 Chat</button>
        <button class="tab" onclick="switchTab('services')">🔌 Services</button>
        <button class="tab" onclick="switchTab('agents')">🤖 Agents</button>
        <button class="tab" onclick="switchTab('store')">🏪 Store</button>
        <button class="tab" onclick="switchTab('backup')">💾 Backup</button>
    </div>
    <!-- Panels -->
    <div class="panels">
        <!-- Chat Panel -->
        <div id="chat-panel" class="panel active">
            <div class="chat-container">
                <div class="chat-messages" id="chatMessages">
                    <div class="message system-message">
                        🧠 <strong>AI Nexus Pro v5.0</strong> — Bienvenue Babacar !<br>
                        💬 Chat vocal · 📎 Upload fichiers · 🔑 4 services IA · ✨ Markdown<br>
                        Configurez vos clés API dans ⚙️ pour activer l'IA
                    </div>
                </div>
                <div class="typing-indicator" id="typingIndicator">
                    <div class="dot"></div><div class="dot"></div><div class="dot"></div>
                </div>
                <div class="voice-indicator" id="voiceIndicator">🎤 Écoute... parlez maintenant</div>
                <div class="quick-actions" id="quickActions">
                    <button class="quick-action" onclick="quickCmd('/help')">❓ Aide</button>
                    <button class="quick-action" onclick="quickCmd('/agents')">🤖 Agents</button>
                    <button class="quick-action" onclick="quickCmd('/services')">🔌 Services</button>
                    <button class="quick-action" onclick="quickCmd('/status')">📊 Statut</button>
                    <button class="quick-action" onclick="quickCmd('/clear')">🗑️ Effacer</button>
                    <button class="quick-action" onclick="exportChat()">📤 Exporter</button>
                </div>
                <div class="input-area">
                    <div class="input-tools">
                        <button class="icon-btn" id="voiceBtn" onclick="toggleVoice()" title="Dictée vocale">🎤</button>
                        <button class="icon-btn" onclick="triggerFileUpload()" title="Joindre fichier">📎</button>
                        <input type="file" id="fileInput" style="display:none" multiple accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.txt,.json,.csv,.zip" onchange="handleFileUpload(event)">
                        <button class="icon-btn" onclick="showAgentPicker()" title="Invoquer agent">@</button>
                    </div>
                    <input type="text" id="messageInput" placeholder="Message, @agent, ou /commande..." onkeypress="if(event.key==='Enter' && !event.shiftKey){sendMessage();}">
                    <button class="send-btn" onclick="sendMessage()" id="sendBtn">➤</button>
                </div>
            </div>
        </div>
        <!-- Services Panel -->
        <div id="services-panel" class="panel">
            <div class="section-title">🔌 Services Cloud</div>
            <div class="section-sub">Cliquez sur un modèle pour le sélectionner · Services configurés ✅</div>
            <div class="service-grid" id="servicesList"></div>
        </div>
        <!-- Agents Panel -->
        <div id="agents-panel" class="panel">
            <div style="display:flex;justify-content:space-between;align-items:center;">
                <div>
                    <div class="section-title">🤖 Mes Agents</div>
                    <div class="section-sub">Agents personnalisés et installés depuis le Store</div>
                </div>
                <button class="btn btn-sm" onclick="openAgentCreateModal()">+ Créer</button>
            </div>
            <div class="agent-grid" id="agentsList"></div>
        </div>
        <!-- Store Panel -->
        <div id="store-panel" class="panel">
            <div class="section-title">🏪 Agent Store</div>
            <div class="section-sub">Installez des agents spécialisés en un clic</div>
            <div class="store-grid" id="storeGrid"></div>
        </div>
        <!-- Backup Panel -->
        <div id="backup-panel" class="panel">
            <div class="section-title">💾 Sauvegarde & Restauration</div>
            <div class="section-sub">Exportez, importez et gérez vos données</div>
            <div class="info-card">
                <h3>📊 Stockage local</h3>
                <div id="storageInfo" style="font-size:0.85em;color:var(--text2);">Calcul en cours...</div>
                <div class="storage-bar-wrap"><div id="storageBar"></div></div>
            </div>
            <div class="backup-actions">
                <button class="btn" onclick="exportFullBackup()">📥 Exporter sauvegarde complète</button>
                <button class="btn btn-outline" onclick="document.getElementById('restoreFileInput').click()">📤 Restaurer une sauvegarde</button>
                <input type="file" id="restoreFileInput" accept=".json" style="display:none" onchange="importFullBackup(event)">
                <button class="btn btn-warning" onclick="exportConfigOnly()">⚙️ Exporter configuration seule</button>
                <button class="btn btn-cyan" onclick="exportChat()">💬 Exporter historique chat</button>
                <button class="btn btn-danger" onclick="resetEverything()">⚠️ Réinitialisation totale</button>
            </div>
            <div class="info-card">
                <h3>📋 Dernières sauvegardes</h3>
                <div id="backupHistory" style="margin-top:8px;color:var(--text2);font-size:0.82em;line-height:1.8;">Aucune sauvegarde récente</div>
            </div>
        </div>
    </div>

    <!-- Settings Modal -->
    <div class="modal" id="settingsModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>⚙️ Paramètres</h2>
                <button class="close-btn" onclick="closeModal('settingsModal')">✕</button>
            </div>
            <!-- Anthropic / Claude -->
            <div class="settings-section">
                <h3>🟣 Anthropic Claude <span id="claudeBadge"></span></h3>
                <div class="form-group">
                    <label>Clé API</label>
                    <input type="password" id="claudeKey" placeholder="sk-ant-..." oninput="updateSettingsBadges()">
                    <small>👉 <a href="https://console.anthropic.com/keys" target="_blank">console.anthropic.com/keys</a></small>
                </div>
                <div class="form-group">
                    <label>Modèle</label>
                    <select id="claudeModel">
                        <option value="claude-sonnet-4-20250514">Claude Sonnet 4 ⭐</option>
                        <option value="claude-opus-4-20250514">Claude Opus 4 (Premium)</option>
                        <option value="claude-haiku-4-5-20251001">Claude Haiku 4.5 (Rapide)</option>
                        <option value="claude-3-5-sonnet-20241022">Claude 3.5 Sonnet</option>
                        <option value="claude-3-haiku-20240307">Claude 3 Haiku</option>
                    </select>
                </div>
            </div>
            <!-- Groq -->
            <div class="settings-section">
                <h3>🚀 Groq Cloud <span id="groqBadge"></span></h3>
                <div class="form-group">
                    <label>Clé API (gratuit — 6k tokens/min)</label>
                    <input type="password" id="groqKey" placeholder="gsk_..." oninput="updateSettingsBadges()">
                    <small>👉 <a href="https://console.groq.com/keys" target="_blank">console.groq.com/keys</a></small>
                </div>
                <div class="form-group">
                    <label>Modèle</label>
                    <select id="groqModel">
                        <option value="llama-3.3-70b-versatile">LLaMA 3.3 70B Versatile ⭐</option>
                        <option value="llama-3.1-8b-instant">LLaMA 3.1 8B Instant (Ultra-rapide)</option>
                        <option value="llama3-70b-8192">LLaMA 3 70B</option>
                        <option value="mixtral-8x7b-32768">Mixtral 8x7B 32k</option>
                        <option value="gemma2-9b-it">Gemma 2 9B</option>
                        <option value="deepseek-r1-distill-llama-70b">DeepSeek R1 Distill 70B</option>
                    </select>
                </div>
            </div>
            <!-- OpenRouter -->
            <div class="settings-section">
                <h3>🔗 Open Router <span id="openrouterBadge"></span></h3>
                <div class="form-group">
                    <label>Clé API</label>
                    <input type="password" id="openRouterKey" placeholder="sk-or-..." oninput="updateSettingsBadges()">
                    <small>👉 <a href="https://openrouter.ai/keys" target="_blank">openrouter.ai/keys</a></small>
                </div>
                <div class="form-group">
                    <label>Modèle</label>
                    <select id="openrouterModel">
                        <option value="anthropic/claude-sonnet-4">Claude Sonnet 4 (via OR)</option>
                        <option value="google/gemini-2.0-flash-001">Gemini 2.0 Flash ⭐</option>
                        <option value="google/gemini-pro-1.5">Gemini Pro 1.5</option>
                        <option value="meta-llama/llama-3.3-70b-instruct">LLaMA 3.3 70B</option>
                        <option value="mistralai/mistral-large">Mistral Large</option>
                        <option value="deepseek/deepseek-chat">DeepSeek V3</option>
                        <option value="qwen/qwen-2.5-72b-instruct">Qwen 2.5 72B</option>
                    </select>
                </div>
            </div>
            <!-- Mistral -->
            <div class="settings-section">
                <h3>🇫🇷 Mistral AI <span id="mistralBadge"></span></h3>
                <div class="form-group">
                    <label>Clé API</label>
                    <input type="password" id="mistralKey" placeholder="..." oninput="updateSettingsBadges()">
                    <small>👉 <a href="https://console.mistral.ai/api-keys" target="_blank">console.mistral.ai</a></small>
                </div>
                <div class="form-group">
                    <label>Modèle</label>
                    <select id="mistralModel">
                        <option value="mistral-large-latest">Mistral Large (Recommandé) ⭐</option>
                        <option value="mistral-small-latest">Mistral Small</option>
                        <option value="codestral-latest">Codestral (Code)</option>
                        <option value="open-mistral-nemo">Mistral Nemo (Gratuit)</option>
                        <option value="open-mixtral-8x7b">Mixtral 8x7B (Gratuit)</option>
                    </select>
                </div>
            </div>
            <!-- General -->
            <div class="settings-section">
                <h3>⚙️ Général</h3>
                <div class="form-group">
                    <label>Service principal</label>
                    <select id="defaultService">
                        <option value="claude">Claude (Anthropic)</option>
                        <option value="groq">Groq</option>
                        <option value="openrouter">Open Router</option>
                        <option value="mistral">Mistral AI</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Langue du système IA</label>
                    <select id="systemLang">
                        <option value="fr">🇫🇷 Français</option>
                        <option value="en">🇬🇧 English</option>
                    </select>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Température: <span id="tempValue">0.7</span></label>
                        <input type="range" id="temperature" min="0" max="2" step="0.1" value="0.7" oninput="document.getElementById('tempValue').textContent=this.value">
                    </div>
                    <div class="form-group">
                        <label>Max tokens</label>
                        <input type="number" id="maxTokens" value="2000" min="100" max="8192">
                    </div>
                </div>
            </div>
            <button class="btn btn-success" onclick="saveSettings()" style="width:100%;margin-bottom:8px;">💾 Sauvegarder</button>
            <button class="btn btn-outline" onclick="closeModal('settingsModal')" style="width:100%;">Fermer</button>
        </div>
    </div>

    <!-- Agent Create Modal -->
    <div class="modal" id="agentModal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>🤖 Créer un Agent</h2>
                <button class="close-btn" onclick="closeModal('agentModal')">✕</button>
            </div>
            <div class="form-group"><label>Nom</label><input type="text" id="agentName" placeholder="MonAgent"></div>
            <div class="form-group"><label>Rôle</label><input type="text" id="agentRole" placeholder="Développeur, Analyste..."></div>
            <div class="form-group"><label>Compétences (virgules)</label><input type="text" id="agentSkills" placeholder="python, analyse, rédaction..."></div>
            <div class="form-group"><label>Instructions système</label><textarea id="agentPrompt" rows="4" placeholder="Tu es un expert en..."></textarea></div>
            <div class="form-group">
                <label>Service IA dédié (optionnel)</label>
                <select id="agentService">
                    <option value="">Auto (service principal)</option>
                    <option value="claude">Claude</option>
                    <option value="groq">Groq</option>
                    <option value="openrouter">OpenRouter</option>
                    <option value="mistral">Mistral</option>
                </select>
            </div>
            <button class="btn btn-success" onclick="createNewAgent()" style="width:100%;">✅ Créer l'agent</button>
        </div>
    </div>

    <script>
    // ==================== CONFIGURATION ====================
    const DEFAULT_CONFIG = {
        services: {
            claude: {
                name: 'Claude (Anthropic)',
                endpoint: 'https://api.anthropic.com/v1/messages',
                models: ['claude-sonnet-4-20250514','claude-opus-4-20250514','claude-haiku-4-5-20251001','claude-3-5-sonnet-20241022','claude-3-haiku-20240307'],
                defaultModel: 'claude-sonnet-4-20250514',
                configured: false, free: false, reqMin: 60, latency: '~300ms',
                desc: 'Claude par Anthropic — meilleure qualité de raisonnement'
            },
            groq: {
                name: 'Groq Cloud',
                endpoint: 'https://api.groq.com/openai/v1/chat/completions',
                models: ['llama-3.3-70b-versatile','llama-3.1-8b-instant','llama3-70b-8192','mixtral-8x7b-32768','gemma2-9b-it','deepseek-r1-distill-llama-70b'],
                defaultModel: 'llama-3.3-70b-versatile',
                configured: false, free: true, reqMin: 30, latency: '~150ms',
                desc: 'Inférence ultra-rapide LPU — LLaMA, Mixtral, Gemma'
            },
            openrouter: {
                name: 'Open Router',
                endpoint: 'https://openrouter.ai/api/v1/chat/completions',
                models: ['anthropic/claude-sonnet-4','google/gemini-2.0-flash-001','google/gemini-pro-1.5','meta-llama/llama-3.3-70b-instruct','mistralai/mistral-large','deepseek/deepseek-chat','qwen/qwen-2.5-72b-instruct'],
                defaultModel: 'google/gemini-2.0-flash-001',
                configured: false, free: true, reqMin: 20, latency: '~400ms',
                desc: 'Accès unifié à 200+ modèles IA'
            },
            mistral: {
                name: 'Mistral AI',
                endpoint: 'https://api.mistral.ai/v1/chat/completions',
                models: ['mistral-large-latest','mistral-small-latest','codestral-latest','open-mistral-nemo','open-mixtral-8x7b'],
                defaultModel: 'mistral-large-latest',
                configured: false, free: false, reqMin: 5, latency: '~600ms',
                desc: 'Modèles européens — Mistral Large, Codestral'
            }
        },
        agents: [],
        installedAgents: [],
        messages: [],
        conversationHistory: [],  // Full API conversation history
        notifications: [],
        backupHistory: [],
        settings: {
            defaultService: 'groq',
            temperature: 0.7,
            maxTokens: 2000,
            claudeKey: '',
            groqKey: '',
            openRouterKey: '',
            mistralKey: '',
            claudeModel: 'claude-sonnet-4-20250514',
            groqModel: 'llama-3.3-70b-versatile',
            openrouterModel: 'google/gemini-2.0-flash-001',
            mistralModel: 'mistral-large-latest',
            systemLang: 'fr',
            theme: 'dark'
        },
        storeAgents: [
            { id: 'email_genius', name: 'EmailGenius Pro', author: 'AI Nexus', icon: '📧', category: 'productivity', desc: 'Rédige, trie et priorise vos emails automatiquement.', tags: ['email', 'productivité'], rating: 4.8, downloads: 15420, featured: true },
            { id: 'content_forge', name: 'ContentForge AI', author: 'CreativeBots', icon: '✍️', category: 'creative', desc: 'Crée du contenu SEO optimisé pour tous formats.', tags: ['contenu', 'SEO'], rating: 4.6, downloads: 12300, featured: true },
            { id: 'code_guardian', name: 'CodeGuardian', author: 'DevTools', icon: '🔍', category: 'dev', desc: 'Analyse de code, détection de bugs, refactoring.', tags: ['code', 'debug'], rating: 4.9, downloads: 8900, featured: false },
            { id: 'smart_analyst', name: 'DataMind AI', author: 'AnalyticsLab', icon: '📊', category: 'business', desc: 'Analyse de données, statistiques et insights.', tags: ['data', 'analyse'], rating: 4.7, downloads: 7200, featured: true },
            { id: 'meet_sync', name: 'MeetSync Pro', author: 'ProductivityAI', icon: '📅', category: 'business', desc: 'Organisation intelligente de réunions et agendas.', tags: ['meeting', 'agenda'], rating: 4.5, downloads: 6700, featured: false },
            { id: 'health_guard', name: 'VitalSigns AI', author: 'HealthTech', icon: '❤️', category: 'health', desc: 'Analyse santé, fitness et conseils personnalisés.', tags: ['santé', 'fitness'], rating: 4.7, downloads: 5400, featured: false },
            { id: 'travel_buddy', name: 'Wanderlust AI', author: 'TravelBots', icon: '✈️', category: 'travel', desc: 'Planification complète de voyages et itinéraires.', tags: ['voyage', 'loisirs'], rating: 4.4, downloads: 4200, featured: false },
            { id: 'pi_dev', name: 'PiNetwork Dev', author: 'BabacarLab', icon: '🥧', category: 'dev', desc: 'Assistant spécialisé Pi Network — Smart contracts, SDK, tokenomics.', tags: ['pi', 'web3', 'smart-contract'], rating: 5.0, downloads: 1337, featured: true }
        ]
    };

    let CONFIG = JSON.parse(JSON.stringify(DEFAULT_CONFIG));
    let isProcessing = false;
    let isRecording = false;
    let recognition = null;

    const SYSTEM_PROMPTS = {
        fr: 'Tu es AI Nexus Pro, un assistant IA puissant et bienveillant. Réponds en français, de manière concise et structurée. Utilise le Markdown pour formater tes réponses : titres, listes, code, tableaux si utiles.',
        en: 'You are AI Nexus Pro, a powerful and helpful AI assistant. Respond clearly and concisely. Use Markdown formatting: headers, lists, code blocks, tables when useful.'
    };

    // ==================== STORAGE ====================
    function saveAll() {
        try {
            const data = { config: CONFIG, savedAt: new Date().toISOString(), version: '5.0' };
            localStorage.setItem('ainexus_v5', JSON.stringify(data));
            CONFIG.backupHistory.unshift({ time: new Date().toISOString(), size: JSON.stringify(data).length });
            if (CONFIG.backupHistory.length > 20) CONFIG.backupHistory.pop();
            updateStorageUI();
        } catch(e) {
            showToast('⚠️ Stockage plein !', 'warning');
        }
    }

    function loadAll() {
        try {
            const saved = localStorage.getItem('ainexus_v5');
            if (saved) {
                const data = JSON.parse(saved);
                if (data.config) {
                    // Merge to preserve new service keys
                    CONFIG = data.config;
                    if (!CONFIG.services.claude) CONFIG.services.claude = DEFAULT_CONFIG.services.claude;
                    if (!CONFIG.conversationHistory) CONFIG.conversationHistory = [];
                    if (!CONFIG.settings.claudeKey) CONFIG.settings.claudeKey = '';
                    if (!CONFIG.settings.claudeModel) CONFIG.settings.claudeModel = DEFAULT_CONFIG.settings.claudeModel;
                    if (!CONFIG.settings.systemLang) CONFIG.settings.systemLang = 'fr';
                }
            }
        } catch(e) { console.error('Load error:', e); }
    }

    function updateStorageUI() {
        let total = 0;
        for (let key in localStorage) {
            if (localStorage.hasOwnProperty(key)) total += (localStorage[key].length || 0) * 2;
        }
        const mb = (total / (1024 * 1024)).toFixed(2);
        const pct = Math.min((total / (5 * 1024 * 1024)) * 100, 100);
        const info = document.getElementById('storageInfo');
        if (info) info.innerHTML = `📊 ${mb} MB utilisé / ~5 MB (${pct.toFixed(1)}%) · ${CONFIG.messages.length} messages · ${CONFIG.agents.length} agents`;
        const bar = document.getElementById('storageBar');
        if (bar) { bar.style.width = pct + '%'; bar.style.background = pct > 80 ? 'linear-gradient(90deg,var(--red),var(--orange))' : 'linear-gradient(90deg,var(--accent),var(--cyan))'; }
        const history = document.getElementById('backupHistory');
        if (history && CONFIG.backupHistory.length > 0) {
            history.innerHTML = CONFIG.backupHistory.slice(0, 5).map(h =>
                `📅 ${new Date(h.time).toLocaleString('fr-FR')} — ${(h.size/1024).toFixed(1)} KB`
            ).join('<br>');
        }
    }

    // ==================== BACKUP/RESTORE ====================
    function exportFullBackup() {
        const data = { config: CONFIG, exportedAt: new Date().toISOString(), version: '5.0' };
        downloadJSON(data, `ainexus_v5_backup_${new Date().toISOString().split('T')[0]}.json`);
        showToast('📥 Sauvegarde exportée !');
    }

    function exportConfigOnly() {
        const data = { settings: { ...CONFIG.settings, claudeKey: '', groqKey: '', openRouterKey: '', mistralKey: '' }, agents: CONFIG.agents.map(a => ({ name: a.name, role: a.role, skills: a.skills })) };
        downloadJSON(data, `ainexus_config_${new Date().toISOString().split('T')[0]}.json`);
        showToast('⚙️ Config exportée (sans clés API)');
    }

    function exportChat() {
        if (CONFIG.messages.length === 0) { showToast('Aucun message à exporter', 'warning'); return; }
        const lines = CONFIG.messages.map(m => {
            const time = new Date(m.time).toLocaleString('fr-FR');
            const who = m.type === 'user' ? '👤 Vous' : m.type === 'ai' ? '🤖 IA' : '⚙️ Système';
            return `[${time}] ${who}:\n${m.content || '[fichier]'}\n`;
        }).join('\n---\n\n');
        const blob = new Blob([`AI Nexus Pro v5 — Export Chat\nDate: ${new Date().toLocaleString('fr-FR')}\n\n${'='.repeat(50)}\n\n${lines}`], { type: 'text/plain' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `chat_export_${new Date().toISOString().split('T')[0]}.txt`;
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showToast('💬 Chat exporté !');
    }

    function importFullBackup(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(e) {
            try {
                const data = JSON.parse(e.target.result);
                if (data.config) {
                    if (confirm('⚠️ Toutes vos données actuelles seront remplacées. Continuer ?')) {
                        CONFIG = data.config;
                        if (!CONFIG.services.claude) CONFIG.services.claude = DEFAULT_CONFIG.services.claude;
                        saveAll(); refreshAll();
                        showToast('✅ Sauvegarde restaurée !');
                    }
                } else { alert('❌ Format de fichier non reconnu'); }
            } catch(err) { alert('❌ Fichier corrompu'); }
        };
        reader.readAsText(file);
        event.target.value = '';
    }

    function resetEverything() {
        if (confirm('⚠️ ATTENTION : Toutes vos données seront effacées !')) {
            if (confirm('Confirmer la réinitialisation totale ?')) {
                localStorage.clear();
                CONFIG = JSON.parse(JSON.stringify(DEFAULT_CONFIG));
                saveAll(); refreshAll();
                document.getElementById('chatMessages').innerHTML = '<div class="message system-message">🔄 Réinitialisation effectuée</div>';
                showToast('🔄 Réinitialisé');
            }
        }
    }

    function downloadJSON(data, filename) {
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = filename;
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }

    // ==================== UI FUNCTIONS ====================
    function switchTab(name) {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
        const tab = document.querySelector(`[onclick="switchTab('${name}')"]`);
        if (tab) tab.classList.add('active');
        const panel = document.getElementById(name + '-panel');
        if (panel) panel.classList.add('active');
        if (name === 'services') renderServices();
        if (name === 'agents') renderAgents();
        if (name === 'store') renderStore();
        if (name === 'backup') updateStorageUI();
        if (name === 'chat') setTimeout(() => document.getElementById('messageInput')?.focus(), 50);
    }

    function toggleTheme() {
        document.body.classList.toggle('light-mode');
        CONFIG.settings.theme = document.body.classList.contains('light-mode') ? 'light' : 'dark';
        saveAll();
    }

    function showToast(msg, type = 'success') {
        const toast = document.createElement('div');
        toast.className = 'toast ' + (type !== 'success' ? type : '');
        toast.textContent = msg;
        document.body.appendChild(toast);
        setTimeout(() => {
            toast.style.opacity = '0'; toast.style.transition = 'opacity 0.3s';
            setTimeout(() => toast.remove(), 300);
        }, 2600);
    }

    function addNotification(type, text) {
        CONFIG.notifications.unshift({ type, text, time: Date.now(), read: false });
        if (CONFIG.notifications.length > 50) CONFIG.notifications.pop();
        updateNotifBadge();
        saveAll();
    }

    function updateNotifBadge() {
        const badge = document.getElementById('notifBadge');
        const unread = CONFIG.notifications.filter(n => !n.read).length;
        if (badge) { badge.textContent = unread; badge.style.display = unread > 0 ? 'flex' : 'none'; }
    }

    function showNotifications() {
        const notifs = CONFIG.notifications.slice(0, 10);
        const msg = notifs.length > 0
            ? notifs.map(n => `${n.type === 'error' ? '❌' : n.type === 'warning' ? '⚠️' : '✅'} ${n.text}`).join('\n')
            : 'Aucune notification';
        alert('🔔 Dernières notifications:\n\n' + msg);
        CONFIG.notifications.forEach(n => n.read = true);
        updateNotifBadge(); saveAll();
    }

    // ==================== CHAT ====================
    function renderMarkdown(text) {
        if (typeof marked !== 'undefined') {
            try {
                return marked.parse(text, { breaks: true, gfm: true });
            } catch(e) { return text; }
        }
        return text.replace(/\n/g, '<br>');
    }

    function addMessage(type, content, extra = {}) {
        const container = document.getElementById('chatMessages');
        const div = document.createElement('div');
        div.className = 'message ' + type + '-message';

        if (extra.fileType) {
            div.className += ' file-message';
            if (extra.fileType.startsWith('image/')) {
                div.innerHTML = `<strong>📷 ${extra.fileName}</strong><br><img src="${extra.dataUrl}" alt="${extra.fileName}" loading="lazy">`;
            } else if (extra.fileType.startsWith('video/')) {
                div.innerHTML = `<strong>🎬 ${extra.fileName}</strong><br><video src="${extra.dataUrl}" controls></video>`;
            } else if (extra.fileType.startsWith('audio/')) {
                div.innerHTML = `<strong>🎵 ${extra.fileName}</strong><br><audio src="${extra.dataUrl}" controls></audio>`;
            } else {
                div.innerHTML = `<strong>📄 ${extra.fileName}</strong><br><span style="font-size:0.8em;color:var(--text2);">${extra.fileType} · ${(extra.fileSize/1024).toFixed(1)} KB</span>`;
            }
        } else if (type === 'ai') {
            const serviceId = CONFIG.settings.defaultService;
            const serviceNames = { claude: '🟣 Claude', groq: '🚀 Groq', openrouter: '🔗 OpenRouter', mistral: '🇫🇷 Mistral' };
            div.innerHTML = `<div class="msg-header">${serviceNames[serviceId] || '🤖 IA'}</div><div class="msg-body">${renderMarkdown(content)}</div>
            <div class="msg-actions">
                <button class="msg-action-btn" onclick="copyMsg(this)">📋 Copier</button>
                <button class="msg-action-btn" onclick="regenMsg()">🔄 Régénérer</button>
            </div>`;
        } else {
            div.textContent = content;
        }

        container.appendChild(div);
        container.scrollTop = container.scrollHeight;

        if (type !== 'system') {
            CONFIG.messages.push({ type, content, extra: extra.fileType ? { fileType: extra.fileType, fileName: extra.fileName } : {}, time: Date.now() });
            if (CONFIG.messages.length > 300) CONFIG.messages = CONFIG.messages.slice(-150);
        }
        saveAll();
    }

    function copyMsg(btn) {
        const msgBody = btn.closest('.message').querySelector('.msg-body');
        if (msgBody) {
            navigator.clipboard.writeText(msgBody.innerText).then(() => showToast('📋 Copié !'));
        }
    }

    let lastUserMessage = '';
    function regenMsg() {
        if (lastUserMessage) processAIResponse(lastUserMessage);
    }

    function showTyping() {
        const t = document.getElementById('typingIndicator');
        if (t) { t.classList.add('show'); t.scrollIntoView({ behavior: 'smooth', block: 'nearest' }); }
    }
    function hideTyping() {
        const t = document.getElementById('typingIndicator');
        if (t) t.classList.remove('show');
    }

    function quickCmd(cmd) {
        document.getElementById('messageInput').value = cmd;
        sendMessage();
    }

    function showAgentPicker() {
        if (CONFIG.agents.length === 0) { showToast('Aucun agent. Créez-en un !', 'warning'); return; }
        document.getElementById('messageInput').value += '@';
        const names = CONFIG.agents.map(a => a.name).join(', ');
        showToast('Agents dispo: ' + names);
        document.getElementById('messageInput').focus();
    }

    async function sendMessage() {
        if (isProcessing) return;
        const input = document.getElementById('messageInput');
        const msg = input.value.trim();
        if (!msg) return;

        if (msg.startsWith('/')) {
            handleCommand(msg);
            input.value = '';
            return;
        }

        const agentMatch = msg.match(/@(\w+)/);
        if (agentMatch) {
            const agentName = agentMatch[1];
            const agent = CONFIG.agents.find(a => a.name.toLowerCase() === agentName.toLowerCase());
            if (agent) {
                addMessage('user', msg);
                input.value = '';
                await invokeAgent(agent, msg.replace(agentMatch[0], '').trim());
                return;
            }
        }

        addMessage('user', msg);
        lastUserMessage = msg;
        input.value = '';
        // Add to conversation history
        CONFIG.conversationHistory.push({ role: 'user', content: msg });
        if (CONFIG.conversationHistory.length > 40) CONFIG.conversationHistory = CONFIG.conversationHistory.slice(-20);
        await processAIResponse(msg);
    }

    function handleCommand(cmd) {
        const [command, ...args] = cmd.split(' ');
        switch(command) {
            case '/help':
                addMessage('system', '📋 **Commandes disponibles:**\n\n`/help` — Cette aide\n`/agents` — Lister les agents\n`/services` — État des services\n`/status` — Statut général\n`/clear` — Effacer le chat\n`/history` — Effacer historique API\n`/backup` — Sauvegarder\n\n**Raccourcis:** Ctrl+S = Save · Ctrl+E = Export');
                break;
            case '/agents':
                const list = CONFIG.agents.length > 0
                    ? CONFIG.agents.map(a => `• **${a.name}** (${a.role}) — ${a.tasksCompleted || 0} tâches`).join('\n')
                    : 'Aucun agent configuré';
                addMessage('system', '🤖 **Agents:**\n\n' + list);
                break;
            case '/services':
                const slist = Object.entries(CONFIG.services).map(([id, s]) =>
                    `• **${s.name}**: ${s.configured ? '✅ Configuré' : '❌ Non configuré'}`
                ).join('\n');
                addMessage('system', '🔌 **Services:**\n\n' + slist);
                break;
            case '/status':
                const active = CONFIG.settings.defaultService;
                const svc = CONFIG.services[active];
                addMessage('system', `🖥️ **Statut:**\n\nService actif: **${svc?.name || active}** ${svc?.configured ? '✅' : '❌'}\nAgents: **${CONFIG.agents.length}**\nMessages: **${CONFIG.messages.length}**\nHistorique API: **${CONFIG.conversationHistory.length}** tours`);
                break;
            case '/clear':
                CONFIG.messages = [];
                document.getElementById('chatMessages').innerHTML = '<div class="message system-message">🗑️ Chat effacé</div>';
                saveAll();
                break;
            case '/history':
                CONFIG.conversationHistory = [];
                saveAll();
                addMessage('system', '🔄 Historique API réinitialisé — nouvelle conversation');
                break;
            case '/backup':
                saveAll();
                addMessage('system', '💾 Sauvegarde effectuée');
                break;
            default:
                addMessage('system', `❓ Commande inconnue: \`${command}\` — Tapez \`/help\``);
        }
    }

    async function processAIResponse(message) {
        isProcessing = true;
        document.getElementById('sendBtn').disabled = true;
        showTyping();
        try {
            const response = await callAI(message);
            hideTyping();
            addMessage('ai', response);
            // Add AI response to history
            CONFIG.conversationHistory.push({ role: 'assistant', content: response });
            if (CONFIG.conversationHistory.length > 40) CONFIG.conversationHistory = CONFIG.conversationHistory.slice(-20);
        } catch(e) {
            hideTyping();
            addMessage('system', '❌ Erreur: ' + e.message);
            addNotification('error', e.message.substring(0, 60));
        } finally {
            isProcessing = false;
            document.getElementById('sendBtn').disabled = false;
            document.getElementById('messageInput').focus();
        }
    }

    async function invokeAgent(agent, task) {
        isProcessing = true;
        document.getElementById('sendBtn').disabled = true;
        addMessage('system', `⏳ ${agent.name} traite la requête...`);
        showTyping();
        try {
            const agentServiceId = agent.serviceId || CONFIG.settings.defaultService;
            const prompt = (agent.systemPrompt ? agent.systemPrompt + '\n\n' : '') + `Tâche: ${task || 'Assistance générale'}`;
            const response = await callAI(prompt, agentServiceId);
            hideTyping();
            addMessage('ai', `🤖 **${agent.name}**: ${response}`);
            agent.tasksCompleted = (agent.tasksCompleted || 0) + 1;
            saveAll(); renderAgents();
        } catch(e) {
            hideTyping();
            addMessage('system', `❌ ${agent.name}: ${e.message}`);
        } finally {
            isProcessing = false;
            document.getElementById('sendBtn').disabled = false;
        }
    }

    async function callAI(message, forceServiceId = null) {
        const serviceId = forceServiceId || CONFIG.settings.defaultService;
        const service = CONFIG.services[serviceId];

        if (!service || !service.configured) {
            await new Promise(r => setTimeout(r, 500));
            const tips = { claude: 'console.anthropic.com/keys', groq: 'console.groq.com/keys', openrouter: 'openrouter.ai/keys', mistral: 'console.mistral.ai/api-keys' };
            return `🤖 **[Mode Démo]** Message reçu.\n\n💡 Configurez une clé API dans ⚙️ **Paramètres** pour activer l'IA réelle !\n\n🔑 Obtenir une clé **${service?.name || serviceId}**: \`${tips[serviceId] || 'voir docs'}\`\n\n> *${message.substring(0, 80)}...*`;
        }

        const lang = CONFIG.settings.systemLang || 'fr';
        const systemPrompt = SYSTEM_PROMPTS[lang] || SYSTEM_PROMPTS.fr;
        const model = CONFIG.settings[serviceId + 'Model'] || service.defaultModel;

        let key = '';
        if (serviceId === 'claude') key = CONFIG.settings.claudeKey;
        else if (serviceId === 'groq') key = CONFIG.settings.groqKey;
        else if (serviceId === 'openrouter') key = CONFIG.settings.openRouterKey;
        else if (serviceId === 'mistral') key = CONFIG.settings.mistralKey;

        // Claude uses different API format
        if (serviceId === 'claude') {
            return await callClaudeAPI(message, model, key, systemPrompt);
        }

        // OpenAI-compatible APIs (Groq, OpenRouter, Mistral)
        const headers = { 'Content-Type': 'application/json', 'Authorization': `Bearer ${key}` };
        if (serviceId === 'openrouter') {
            headers['HTTP-Referer'] = 'https://ainexuspro.app';
            headers['X-Title'] = 'AI Nexus Pro v5';
        }

        // Build messages with conversation history
        const historyMessages = CONFIG.conversationHistory.slice(-10); // Last 5 turns
        const messages = [
            { role: 'system', content: systemPrompt },
            ...historyMessages.slice(0, -1), // All history except current
            { role: 'user', content: message }
        ];

        const response = await fetch(service.endpoint, {
            method: 'POST', headers,
            body: JSON.stringify({
                model,
                messages,
                temperature: CONFIG.settings.temperature,
                max_tokens: CONFIG.settings.maxTokens
            })
        });

        if (!response.ok) {
            const err = await response.json().catch(() => ({}));
            throw new Error(`${service.name}: ${err.error?.message || 'HTTP ' + response.status}`);
        }

        const data = await response.json();
        return data.choices[0].message.content;
    }

    async function callClaudeAPI(message, model, key, systemPrompt) {
        const historyMessages = CONFIG.conversationHistory.slice(-10);
        const messages = [
            ...historyMessages.slice(0, -1),
            { role: 'user', content: message }
        ];

        const response = await fetch('https://api.anthropic.com/v1/messages', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'x-api-key': key,
                'anthropic-version': '2023-06-01',
                'anthropic-dangerous-direct-browser-access': 'true'
            },
            body: JSON.stringify({
                model,
                max_tokens: CONFIG.settings.maxTokens || 2000,
                system: systemPrompt,
                messages: messages.length > 0 ? messages : [{ role: 'user', content: message }]
            })
        });

        if (!response.ok) {
            const err = await response.json().catch(() => ({}));
            throw new Error(`Claude: ${err.error?.message || 'HTTP ' + response.status}`);
        }

        const data = await response.json();
        return data.content[0].text;
    }

    // ==================== VOICE ====================
    function toggleVoice() { isRecording ? stopVoice() : startVoice(); }

    function startVoice() {
        if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
            showToast('🎤 Reconnaissance vocale non supportée (utilisez Chrome)', 'warning');
            return;
        }
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        recognition = new SpeechRecognition();
        recognition.lang = CONFIG.settings.systemLang === 'en' ? 'en-US' : 'fr-FR';
        recognition.continuous = true;
        recognition.interimResults = true;
        recognition.onstart = () => {
            isRecording = true;
            document.getElementById('voiceBtn').classList.add('recording');
            document.getElementById('voiceIndicator').classList.add('active');
            document.getElementById('messageInput').placeholder = '🎤 Écoute...';
        };
        recognition.onresult = (event) => {
            let transcript = '';
            for (let i = event.resultIndex; i < event.results.length; i++) {
                transcript += event.results[i][0].transcript;
            }
            document.getElementById('messageInput').value = transcript;
        };
        recognition.onerror = (event) => {
            stopVoice();
            if (event.error === 'not-allowed') showToast('⚠️ Autorisez le microphone', 'warning');
        };
        recognition.onend = () => { if (isRecording) stopVoice(); };
        recognition.start();
    }

    function stopVoice() {
        if (recognition) { recognition.stop(); recognition = null; }
        isRecording = false;
        document.getElementById('voiceBtn').classList.remove('recording');
        document.getElementById('voiceIndicator').classList.remove('active');
        document.getElementById('messageInput').placeholder = 'Message, @agent, ou /commande...';
    }

    // ==================== FILE UPLOAD ====================
    function triggerFileUpload() { document.getElementById('fileInput').click(); }

    function handleFileUpload(event) {
        const files = event.target.files;
        if (!files || files.length === 0) return;
        Array.from(files).forEach(file => {
            const reader = new FileReader();
            reader.onload = function(e) {
                addMessage('user', '', { fileType: file.type, fileName: file.name, fileSize: file.size, dataUrl: e.target.result });
                const input = document.getElementById('messageInput');
                input.value = `[Fichier: ${file.name}] Analyse ce fichier et décris son contenu`;
                sendMessage();
            };
            reader.readAsDataURL(file);
        });
        event.target.value = '';
        showToast(`📎 ${files.length} fichier(s) joint(s)`);
    }

    // ==================== SERVICES ====================
    function updateServicesConfig() {
        CONFIG.services.claude.configured = !!CONFIG.settings.claudeKey;
        CONFIG.services.groq.configured = !!CONFIG.settings.groqKey;
        CONFIG.services.openrouter.configured = !!CONFIG.settings.openRouterKey;
        CONFIG.services.mistral.configured = !!CONFIG.settings.mistralKey;
    }

    function renderServices() {
        const container = document.getElementById('servicesList');
        if (!container) return;
        updateServicesConfig();
        container.innerHTML = Object.entries(CONFIG.services).map(([id, s]) => {
            const isDefault = CONFIG.settings.defaultService === id;
            const extraClass = id === 'claude' ? 'anthropic-card' : '';
            return `
            <div class="service-card ${s.configured ? 'configured' : ''} ${extraClass}">
                <div class="service-header">
                    <span class="service-name">${s.name}</span>
                    <span class="service-status ${s.configured ? 'status-ok' : 'status-no'}">${s.configured ? '✅ OK' : '❌ Inactif'}</span>
                </div>
                <div class="service-desc">${s.desc}</div>
                <div style="font-size:0.77em;color:var(--text2);margin-bottom:6px;">⚡ ${s.reqMin} req/min · ⏱️ ${s.latency} · ${s.free ? '🆓 Gratuit' : '💳 Payant'}</div>
                <div class="service-models">
                    ${s.models.map(m => `<span class="model-tag ${CONFIG.settings[id+'Model'] === m ? 'active' : ''}" onclick="selectModel('${id}','${m}')">${m}</span>`).join('')}
                </div>
                <div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap;">
                    <button class="btn btn-sm ${isDefault ? 'btn-success' : 'btn-outline'}" onclick="setDefaultService('${id}')">${isDefault ? '✅ Principal' : 'Définir principal'}</button>
                    ${!s.configured ? `<button class="btn btn-sm btn-outline" onclick="openSettings()">🔑 Configurer</button>` : ''}
                </div>
            </div>`;
        }).join('');
    }

    function selectModel(serviceId, model) {
        CONFIG.settings[serviceId + 'Model'] = model;
        saveAll(); renderServices();
        showToast(`✅ ${model}`);
    }

    function setDefaultService(serviceId) {
        if (!CONFIG.services[serviceId].configured) {
            showToast('⚠️ Configurez d\'abord la clé API', 'warning');
            openSettings();
            return;
        }
        CONFIG.settings.defaultService = serviceId;
        saveAll(); renderServices();
        showToast(`✅ ${CONFIG.services[serviceId].name} → Service principal`);
    }

    // ==================== AGENTS ====================
    function renderAgents() {
        const container = document.getElementById('agentsList');
        if (!container) return;
        if (CONFIG.agents.length === 0) {
            container.innerHTML = '<div class="empty-state"><div class="empty-icon">🤖</div>Aucun agent. Créez-en un ou installez depuis le Store.</div>';
            return;
        }
        container.innerHTML = CONFIG.agents.map(a => `
            <div class="agent-card">
                <h3>🤖 ${a.name}</h3>
                <div class="agent-role">${a.role}</div>
                <div class="agent-tags">${(a.skills || []).map(s => `<span class="agent-tag">${s}</span>`).join('')}</div>
                <div class="agent-stats">📊 ${a.tasksCompleted || 0} tâches · ✅ ${a.successRate || 100}% succès ${a.serviceId ? `· 🔌 ${a.serviceId}` : ''}</div>
                <div class="agent-actions">
                    <button class="btn btn-sm" onclick="invokeAgentDirect('${a.id}')">▶️ Exécuter</button>
                    <button class="btn btn-sm btn-danger" onclick="removeAgent('${a.id}')">🗑️</button>
                </div>
            </div>
        `).join('');
    }

    function openAgentCreateModal() { document.getElementById('agentModal').classList.add('active'); }

    function createNewAgent() {
        const name = document.getElementById('agentName').value.trim();
        if (!name) { showToast('Nom requis !', 'warning'); return; }
        CONFIG.agents.push({
            id: 'agent_' + Date.now(),
            name,
            role: document.getElementById('agentRole').value || 'Assistant',
            skills: document.getElementById('agentSkills').value.split(',').map(s => s.trim()).filter(Boolean),
            systemPrompt: document.getElementById('agentPrompt').value,
            serviceId: document.getElementById('agentService').value || null,
            tasksCompleted: 0, successRate: 100, status: 'idle'
        });
        saveAll(); closeModal('agentModal'); renderAgents();
        showToast(`✅ Agent "${name}" créé !`);
        ['agentName','agentRole','agentSkills','agentPrompt','agentService'].forEach(id => {
            const el = document.getElementById(id);
            if (el) el.value = '';
        });
    }

    function removeAgent(id) {
        if (!confirm('Supprimer cet agent ?')) return;
        CONFIG.agents = CONFIG.agents.filter(a => a.id !== id);
        const storeId = id.replace('store_', '');
        CONFIG.installedAgents = CONFIG.installedAgents.filter(i => i !== storeId);
        saveAll(); renderAgents(); renderStore();
        showToast('🗑️ Agent supprimé');
    }

    function invokeAgentDirect(id) {
        const agent = CONFIG.agents.find(a => a.id === id);
        if (!agent) return;
        const task = prompt(`Tâche pour ${agent.name}:`);
        if (task) {
            switchTab('chat');
            document.getElementById('messageInput').value = `@${agent.name} ${task}`;
            sendMessage();
        }
    }

    // ==================== STORE ====================
    function renderStore() {
        const container = document.getElementById('storeGrid');
        if (!container) return;
        container.innerHTML = CONFIG.storeAgents.map(agent => {
            const installed = CONFIG.installedAgents.includes(agent.id);
            return `
            <div class="store-card ${agent.featured ? 'featured' : ''}">
                ${agent.featured ? '<div style="position:absolute;top:10px;right:10px;background:var(--gold);color:#000;padding:2px 8px;border-radius:20px;font-size:0.64em;font-family:Syne,sans-serif;font-weight:700;">⭐ Featured</div>' : ''}
                <div class="store-icon">${agent.icon}</div>
                <h3>${agent.name}</h3>
                <div class="store-author">par ${agent.author}</div>
                <div class="store-desc">${agent.desc}</div>
                <div class="store-tags">${agent.tags.map(t => `<span class="store-tag">${t}</span>`).join('')}</div>
                <div class="store-stats">
                    <span class="rating">⭐ ${agent.rating}</span>
                    <span>📥 ${agent.downloads > 1000 ? (agent.downloads/1000).toFixed(1)+'k' : agent.downloads}</span>
                </div>
                <button class="install-btn ${installed ? 'installed' : ''}" onclick="${installed ? `uninstallFromStore('${agent.id}')` : `installFromStore('${agent.id}')`}">
                    ${installed ? '✅ Installé · Cliquer pour retirer' : '📥 Installer'}
                </button>
            </div>`;
        }).join('');
    }

    function installFromStore(agentId) {
        if (CONFIG.installedAgents.includes(agentId)) return;
        const storeAgent = CONFIG.storeAgents.find(a => a.id === agentId);
        if (!storeAgent) return;
        CONFIG.installedAgents.push(agentId);
        storeAgent.downloads++;
        const roleMap = { productivity: 'Assistant Productivité', creative: 'Assistant Créatif', dev: 'Assistant Dev', business: 'Assistant Business', health: 'Assistant Santé', travel: 'Assistant Voyage' };
        CONFIG.agents.push({
            id: 'store_' + agentId,
            name: storeAgent.name,
            role: roleMap[storeAgent.category] || 'Assistant',
            skills: storeAgent.tags,
            systemPrompt: `Tu es ${storeAgent.name}. ${storeAgent.desc} Réponds en détail et de manière professionnelle.`,
            tasksCompleted: 0, successRate: 100, status: 'idle'
        });
        saveAll(); renderStore(); renderAgents();
        showToast(`✅ ${storeAgent.name} installé !`);
        addNotification('success', `Agent ${storeAgent.name} installé`);
    }

    function uninstallFromStore(agentId) {
        CONFIG.installedAgents = CONFIG.installedAgents.filter(i => i !== agentId);
        CONFIG.agents = CONFIG.agents.filter(a => a.id !== 'store_' + agentId);
        saveAll(); renderStore(); renderAgents();
        showToast('🗑️ Agent désinstallé');
    }

    // ==================== SETTINGS ====================
    function openSettings() {
        document.getElementById('settingsModal').classList.add('active');
        document.getElementById('claudeKey').value = CONFIG.settings.claudeKey || '';
        document.getElementById('groqKey').value = CONFIG.settings.groqKey || '';
        document.getElementById('openRouterKey').value = CONFIG.settings.openRouterKey || '';
        document.getElementById('mistralKey').value = CONFIG.settings.mistralKey || '';
        document.getElementById('defaultService').value = CONFIG.settings.defaultService || 'groq';
        document.getElementById('temperature').value = CONFIG.settings.temperature || 0.7;
        document.getElementById('tempValue').textContent = CONFIG.settings.temperature || 0.7;
        document.getElementById('maxTokens').value = CONFIG.settings.maxTokens || 2000;
        document.getElementById('claudeModel').value = CONFIG.settings.claudeModel || 'claude-sonnet-4-20250514';
        document.getElementById('groqModel').value = CONFIG.settings.groqModel || 'llama-3.3-70b-versatile';
        document.getElementById('openrouterModel').value = CONFIG.settings.openrouterModel || 'google/gemini-2.0-flash-001';
        document.getElementById('mistralModel').value = CONFIG.settings.mistralModel || 'mistral-large-latest';
        document.getElementById('systemLang').value = CONFIG.settings.systemLang || 'fr';
        updateSettingsBadges();
    }

    function updateSettingsBadges() {
        const badges = { claudeBadge: 'claudeKey', groqBadge: 'groqKey', openrouterBadge: 'openRouterKey', mistralBadge: 'mistralKey' };
        Object.entries(badges).forEach(([badgeId, inputId]) => {
            const el = document.getElementById(badgeId);
            const val = document.getElementById(inputId)?.value?.trim();
            if (el) el.innerHTML = val ? '<span style="color:var(--green);">✅</span>' : '<span style="color:var(--red);">❌</span>';
        });
    }

    function saveSettings() {
        CONFIG.settings.claudeKey = document.getElementById('claudeKey').value.trim();
        CONFIG.settings.groqKey = document.getElementById('groqKey').value.trim();
        CONFIG.settings.openRouterKey = document.getElementById('openRouterKey').value.trim();
        CONFIG.settings.mistralKey = document.getElementById('mistralKey').value.trim();
        CONFIG.settings.defaultService = document.getElementById('defaultService').value;
        CONFIG.settings.temperature = parseFloat(document.getElementById('temperature').value);
        CONFIG.settings.maxTokens = parseInt(document.getElementById('maxTokens').value);
        CONFIG.settings.claudeModel = document.getElementById('claudeModel').value;
        CONFIG.settings.groqModel = document.getElementById('groqModel').value;
        CONFIG.settings.openrouterModel = document.getElementById('openrouterModel').value;
        CONFIG.settings.mistralModel = document.getElementById('mistralModel').value;
        CONFIG.settings.systemLang = document.getElementById('systemLang').value;
        updateServicesConfig();
        saveAll(); closeModal('settingsModal'); renderServices();
        showToast('✅ Configuration sauvegardée !');
        addNotification('success', 'Paramètres mis à jour');
    }

    function openBackupModal() { switchTab('backup'); }

    function closeModal(id) { document.getElementById(id).classList.remove('active'); }

    function refreshAll() {
        renderServices(); renderAgents(); renderStore();
        updateStorageUI(); updateNotifBadge();
    }

    // Close modal on outside click
    document.querySelectorAll('.modal').forEach(modal => {
        modal.addEventListener('click', function(e) {
            if (e.target === this) this.classList.remove('active');
        });
    });

    // Keyboard shortcuts
    document.addEventListener('keydown', function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key === 's') {
            e.preventDefault(); saveAll(); showToast('💾 Sauvegardé');
        }
        if ((e.ctrlKey || e.metaKey) && e.key === 'e') {
            e.preventDefault(); exportFullBackup();
        }
        if (e.key === 'Escape') {
            document.querySelectorAll('.modal.active').forEach(m => m.classList.remove('active'));
        }
    });

    // Auto-save every 30s
    setInterval(() => { if (CONFIG.messages.length > 0) saveAll(); }, 30000);

    // ==================== INIT ====================
    function init() {
        loadAll();
        updateServicesConfig();
        if (CONFIG.settings.theme === 'light') document.body.classList.add('light-mode');
        renderServices(); renderAgents(); renderStore();
        updateStorageUI(); updateNotifBadge();
        // Configure marked
        if (typeof marked !== 'undefined') {
            marked.setOptions({ breaks: true, gfm: true });
        }
        console.log('%c🧠 AI Nexus Pro v5.0', 'font-size:16px;font-weight:bold;color:#a855f7');
        console.log('✅ Services: Claude, Groq, OpenRouter, Mistral');
        console.log('✅ Markdown rendering: Activé');
        console.log('✅ Historique conversation: Activé');
        console.log('✅ Export chat: Activé');
        console.log('💡 /help pour les commandes');
    }

    init();
    </script>
</body>
</html>
